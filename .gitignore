# Pesos e derivados -- dezenas de GB, e todos reproduziveis.
#   models/     baixado por download_model.py, convertido por tools/convert
#   offload/    sobra da referencia externa em transformers (docs/17); a
#               ferramenta que a criava nao existe mais, mas quem repetir a
#               medicao vai gerar de novo -- e sao dezenas de GB
#   publish/stage/  pasta de upload montada por publish/publish.ps1; o
#                   container entra nela por LINK DURO, entao aparecem 19,8 GB
models/
offload/
publish/stage/

# Artefatos de build.
build/
obj/
*.obj
*.exe
*.dll
*.lib
*.exp
*.pdb
*.ilk

# Carimbo de build: derivado do hash das fontes, muda a cada compilacao.
# Versiona-lo criaria conflito em todo merge sem informar nada.
src/build_id.h

__pycache__/
*.pyc

# Saidas de medicao. O que interessa delas esta em docs/, com o contexto que
# as torna interpretaveis; o arquivo cru nao se explica sozinho.
*.bin
*.npy
ablate_raw.json
bench*.txt
ablate_*.txt
ppl*.txt
serve.log
serve.out

# Sessoes de profiling do Visual Studio -- 11 MB de ETW por captura, e a
# leitura delas e que vale (docs/23), nao o arquivo bruto.
Profile/
*.diagsession

# Resultados do benchserve: numeros desta maquina, desta hora. O harness e
# versionado, o CSV nao -- ele so significa algo junto do hardware que o
# produziu, e cresce a cada execucao.
Tests/benchserve/results/

# Cache e preferencias locais do Visual Studio.
.vs/
*.vcxproj.user

# Saidas de servidor/agente disparados a mao durante o desenvolvimento.
*.log
srv.out
srv.err

# Corpus derivado dos proprios docs -- regenera com um comando, e mudaria a
# cada edicao de documentacao.
corpus.txt
corpus_rep.txt

# NAO ignorados de proposito, e vale dizer por que:
#   src/fixture_kernels.h    gerados por tools/fixture e tools/ucd, mas
#   src/unicode_tables.h     versionados: sem eles o build exigiria rodar as
#                            duas ferramentas -- e o ucd exige baixar a base
#                            Unicode -- so para compilar
#   corpus_prosa.txt         corpus de calibracao; o numero de docs/17 so
#                            significa alguma coisa com ESTE texto
#   ids32.txt, ref32.json    referencia do oraculo, presa ao container v3
#   tokfixture.json          ids de referencia da HuggingFace
